<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.developerjamiu.screen_time_blocker">

    <!-- Query all installed apps (required for Android 11+) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Draw overlay for blocking screen -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Request to ignore battery optimization -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Notifications for blocking alerts -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground service for persistent blocking -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Restart service on boot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Schedule exact alarms for precise schedule timing -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Wake lock for reliable scheduling -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <!-- Accessibility Service for detecting foreground apps -->
        <service
            android:name=".service.AppBlockerAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- App Picker Activity -->
        <activity
            android:name=".ui.AppPickerActivity"
            android:theme="@style/Theme.ScreenTimeBlocker.AppPicker"
            android:exported="false"
            android:configChanges="orientation|screenSize" />

        <!-- Blocking Overlay Service -->
        <service
            android:name=".service.BlockingOverlayService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />

        <!-- Boot Receiver to restart service -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Schedule Alarm Receiver -->
        <receiver
            android:name=".receiver.ScheduleAlarmReceiver"
            android:exported="false" />

    </application>
</manifest>
