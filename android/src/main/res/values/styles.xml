<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App Picker Theme -->
    <style name="Theme.ScreenTimeBlocker.AppPicker" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- Blocking Overlay Theme -->
    <style name="Theme.ScreenTimeBlocker.Overlay" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/overlay_background</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
